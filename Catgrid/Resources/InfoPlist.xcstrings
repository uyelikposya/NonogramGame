    "NSUserTrackingUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing tracking lets us show you more relevant ads. Ads help keep Catgrid free to play."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verirsen sana daha ilgili reklamlar gösterebiliriz. Reklamlar Catgrid'in ücretsiz oynanmasını sağlar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラッキングを許可すると、より関連性の高い広告が表示されます。広告のおかげでCatgridを無料で遊べます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Tracking erlaubst, zeigen wir dir passendere Werbung. Werbung hilft, Catgrid kostenlos spielbar zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le suivi nous permet de t'afficher des publicités plus pertinentes. La publicité aide à garder Catgrid gratuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si permites el seguimiento, te mostraremos anuncios más relevantes. Los anuncios ayudan a que Catgrid sea gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o rastreamento nos ajuda a mostrar anúncios mais relevantes. Os anúncios mantêm o Catgrid gratuito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적을 허용하면 더 관련성 높은 광고를 보여 드릴 수 있어요. 광고 덕분에 Catgrid를 무료로 즐길 수 있어요."
          }
        }
      }
    }
  }
}
