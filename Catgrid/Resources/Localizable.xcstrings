    "When a clue is as long as the line, the whole line is filled. Start there!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu satır kadar uzunsa satırın tamamı doludur. Oradan başla!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒントの数字が列の長さと同じなら、その列はすべて塗られます。まずはそこから！"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist eine Zahl so lang wie die Zeile, ist die ganze Zeile gefüllt. Fang dort an!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un indice est aussi long que la ligne, toute la ligne est remplie. Commence par là !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una pista es tan larga como la línea, toda la línea está rellena. ¡Empieza por ahí!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma dica é do tamanho da linha, a linha inteira é preenchida. Comece por aí!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자가 줄 길이와 같으면 줄 전체를 칠해요. 거기서부터 시작해 봐요!"
          }
        }
      }
    },
