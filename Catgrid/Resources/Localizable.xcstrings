    "We'll send one gentle reminder a day, only on days you haven't played. You can change this in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde tek bir nazik hatırlatma göndeririz, yalnızca oynamadığın günlerde. Bunu Ayarlar'dan değiştirebilirsin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遊んでいない日だけ、1日1回やさしくお知らせします。設定でいつでも変更できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden höchstens eine sanfte Erinnerung pro Tag – nur an Tagen, an denen du nicht gespielt hast. Du kannst das in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons un petit rappel par jour, uniquement les jours où vous n'avez pas joué. Modifiable dans les Réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviaremos un recordatorio amable al día, solo los días que no hayas jugado. Puedes cambiarlo en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um lembrete gentil por dia, só nos dias em que você não jogar. Você pode mudar isso nos Ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하지 않은 날에만 하루 한 번 살짝 알려 드려요. 설정에서 바꿀 수 있어요."
          }
        }
      }
    },
