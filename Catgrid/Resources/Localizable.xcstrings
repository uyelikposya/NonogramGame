    "Purr… I can't spot a sure move. Check your marks!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mırr… kesin bir hamle göremiyorum. İşaretlerini kontrol et!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴロゴロ… 確実な手が見つからないにゃ。印を見直してみて！"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnurr … Ich sehe keinen sicheren Zug. Prüf deine Markierungen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rrr… Je ne vois aucun coup sûr. Vérifie tes marques !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Purr… No veo ningún movimiento seguro. ¡Revisa tus marcas!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rrrr… Não vejo nenhuma jogada certa. Confira suas marcações!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그르릉… 확실한 수가 안 보여요. 표시한 칸을 확인해 봐요!"
          }
        }
      }
    },
