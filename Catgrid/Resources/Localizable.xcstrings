          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Katzenkarte ist vielleicht nur ein Rätsel entfernt!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle fiche chat n'est peut-être qu'à une grille !"
          }
        },
        "es": {
          "stringUnit": {
