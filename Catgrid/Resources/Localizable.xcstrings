            "value": "도파민"
          }
        }
      }
    },
    "Calm and simple: soft music, no distractions.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakin ve sade: yumuşak müzik, dikkat dağıtan hiçbir şey yok."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかでシンプル:やさしい音楽、気が散るものはありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhig und schlicht: sanfte Musik, keine Ablenkung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme et simple : musique douce, aucune distraction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranquilo y sencillo: música suave, sin distracciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo e simples: música suave, sem distrações."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차분하고 단순하게: 부드러운 음악, 방해 요소 없음."
          }
        }
      }
    },
    "Sparkles for every line, celebrations for every puzzle and upbeat music.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satırda parıltı, her bulmacada kutlama ve hareketli müzik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列ごとにキラキラ、パズルごとにお祝い、そしてノリのいい音楽。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkeln für jede Zeile, Feiern für jedes Rätsel und fröhliche Musik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des étincelles à chaque ligne, une fête à chaque grille et une musique entraînante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destellos en cada línea, celebraciones en cada puzle y música animada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Brilhos a cada linha, festa a cada desafio e música animada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄마다 반짝임, 퍼즐마다 축하, 그리고 신나는 음악."
          }
        }
      }
    },
    "Tip: like it calm or lively? Pick Relax or Dopamine mode in Settings → Play Style.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Sakin mi seversin, hareketli mi? Ayarlar → Oyun Tarzı'ndan Rahat ya da Dopamin modunu seç."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント:のんびり派?にぎやか派?設定 → プレイスタイルで「リラックス」か「ドーパミン」を選べます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Lieber ruhig oder lebhaft? Wähle unter Einstellungen → Spielstil den Modus Entspannt oder Dopamin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : plutôt calme ou animé ? Choisis le mode Détente ou Dopamine dans Réglages → Style de jeu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: ¿tranquilo o animado? Elige el modo Relax o Dopamina en Ajustes → Estilo de juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: prefere calmo ou animado? Escolha o modo Relax ou Dopamina em Ajustes → Estilo de Jogo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 차분한 게 좋아요, 신나는 게 좋아요? 설정 → 플레이 스타일에서 릴랙스나 도파민 모드를 고르세요."
          }
        }
      }
    },
