    "Midnight Blue": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece Mavisi"
          }
        }
      }
    },
    "Mind your paws": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patilerine dikkat"
          }
        }
      }
    },
    "New best time!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni rekor süre!"
          }
        }
      }
    },
    "New breeds are on their way.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni türler yolda."
          }
        }
      }
    },
    "Next Puzzle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki Bulmaca"
          }
        }
      }
    },
    "Numbers tell you how many squares in a line are filled. A 3 means three filled squares side by side. Tap a square to fill it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayılar bir satırda kaç karenin dolu olduğunu söyler. 3, yan yana üç dolu kare demektir. Doldurmak için bir kareye dokun."
          }
        }
      }
    },
    "Out of paws": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patilerin bitti"
          }
        }
      }
    },
    "Pastel": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastel"
          }
        }
      }
    },
    "Perfect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatasız"
          }
        }
      }
    },
    "Progress": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme"
          }
        }
      }
    },
    "Purrfect!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mırr-ükemmel!"
          }
        }
      }
    },
