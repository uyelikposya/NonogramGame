      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemeyi Sıfırla"
          }
        }
      }
    },
    "Reset all progress?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm ilerleme sıfırlansın mı?"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldığın Yerden Devam Et"
          }
        }
      }
    },
    "Rows meet columns": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satırlar ve sütunlar"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar"
          }
        }
      }
    },
    "Several blocks": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla blok"
          }
        }
      }
    },
    "Solved": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çözülen"
          }
        }
      }
    },
    "Start Playing": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynamaya Başla"
          }
        }
      }
    },
    "Statistics": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistikler"
          }
        }
      }
    },
    "Switch to the X tool to mark squares you know are empty. It keeps your thinking tidy.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş olduğunu bildiğin kareleri X aracıyla işaretle. Böylece kafan karışmaz."
          }
        }
      }
    },
    "Tap to fill": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doldurmak için dokun"
          }
        }
      }
    },
    "The game follows your device language. You can choose a different language just for this app in Settings.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyun cihazının dilini kullanır. Ayarlar'dan yalnızca bu uygulama için farklı bir dil seçebilirsin."
          }
        }
      }
    },
    "Time %@ · %lld mistakes": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Time %@ · %lld mistake"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Time %@ · %lld mistakes"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre %@ · %lld hata"
          }
        }
      }
    },
    "Time %@ · Best %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre %@ · En iyi %@"
          }
        }
      }
    },
    "Time's up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süre doldu"
          }
        }
      }
    },
    "Total Time": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam Süre"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar Dene"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri Al"
          }
        }
      }
    },
    "Use the edges": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenarları kullan"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm %@"
          }
        }
      }
    },
    "When a clue is as long as the line, the whole line is filled. Start there!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu satır kadar uzunsa satırın tamamı doludur. Oradan başla!"
          }
        }
      }
    },
    "You know all the rules. Solve this one on your own!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kuralları biliyorsun. Bunu kendi başına çöz!"
          }
        }
      }
    },
    "You solved every puzzle!": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm bulmacaları çözdün!"
          }
        }
      }
    }
  },
  "version": "1.0"
}
