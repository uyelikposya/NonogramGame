      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulmaca %lld · %lld×%lld"
          }
        }
      }
    },
    "Puzzle %lld, in progress": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulmaca %lld, devam ediyor"
          }
